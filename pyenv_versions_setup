#!/usr/bin/env zsh
# vim:expandtab:ts=2:sw=2

###########################
### CONFIGURATION VARIABLES

# The python version to use for tools and jupyter environments.  This will be
# set to the most recent installed Python version unless overridden here.
# PY3_TOOLS=3.14.1

# Packages to install in each environment
JUPYTER_PACKAGES=(jupyter ipython notebook)
TOOLS_PACKAGES=(ansible flake8 restview rst2pdf xml2rfc linkchecker pre-commit)

# Global packages are installed in whatever the "latest" Python 3.x version
# is, which is what goes at the top of the globals list.
GLOBAL_PACKAGES=(rich)

# The low and high Python 3 minor versions to install
# '10' for 3.10, 11 for 3.11, etc.
PY3_LOW_MINOR=9
PY3_HIGH_MINOR=15

# Extra environment for `pyenv install` of specific Python 3 minor versions.
# Keys are inclusive minor-version ranges "LOW-HIGH" (either bound may be
# empty for open-ended); values are shell-quoted VAR=value assignments, e.g.
#   "14-" 'PYTHON_CONFIGURE_OPTS="--enable-shared --with-lto"'
# All matching entries are applied; if overlapping ranges set the same
# variable, the entry whose key sorts last wins.
typeset -A PY3_BUILD_ENV=(
  # Keep Python-only options out of dependency builds (such as OpenSSL).
  "-" "PYTHON_CONFIGURE_OPTS=--enable-optimizations"
  "-13" "PYTHON_BUILD_HOMEBREW_OPENSSL_FORMULA=openssl@3"
  # Python 3.9 needs Tcl/Tk 8; install it with brew install tcl-tk@8.
  # Avoid SDK-only pipe2/dup3 symbols that are unavailable at runtime on macOS 26.
  "-9" "PYTHON_BUILD_HOMEBREW_TCLTK_FORMULA=tcl-tk@8 ac_cv_func_pipe2=no ac_cv_func_dup3=no"
)


### END OF CONFIGURATION
###########################

# set -euxo pipefail
set -uo pipefail

PYENV_ROOT=~/.pyenv
export PATH=${PYENV_ROOT}/bin:${PATH}
eval "$(pyenv init -)"

# Fill BUILD_ENV with the PY3_BUILD_ENV assignments that apply to Python
# version $1, one VAR=value per element.
py3_build_env() {
  local ver=$1 minor range lo hi
  BUILD_ENV=()
  [[ $ver == 3.* ]] || return 0
  minor=${${ver#3.}%%.*}
  for range in ${(ko)PY3_BUILD_ENV}; do
    lo=${range%%-*}; hi=${range##*-}
    (( minor >= ${lo:-0} && minor <= ${hi:-9999} )) || continue
    BUILD_ENV+=(${(Q)${(z)PY3_BUILD_ENV[$range]}})
  done
}

PY2VER=(2.7.18)
PY3VER=("${(@f)$(
  for (( minor=PY3_LOW_MINOR; minor<=PY3_HIGH_MINOR; minor++ )); do
    pyenv install -l |
      grep -oE "3\.${minor}\.[0-9]+$" |        # emit only the version, no leading spaces
      sort -t . -k3,3n | tail -1
  done | sort -t . -k2,2rn
)}")

PY3_TOOLS=${PY3_TOOLS:-${PY3VER[1]}}
PY3VER=($PY3_TOOLS $PY3VER)
PY3VER=(${(Onu)PY3VER})

if [[ ${PY3VER[1]} != $PY3_TOOLS ]]; then
  print -u2 -P "%F{red}%BWARNING%B%f: PY3_TOOLS ($PY3_TOOLS) is not the latest release."
fi

JUPYTER_ENV="jupyter${PY3_TOOLS}"
TOOLS_ENV="tools${PY3_TOOLS}"

INSTALLED=($(pyenv version --bare))

# If VER isn't found in INSTALLED (the returned index search is larger than
# the size of the array) then install it.
for VER in $PY2VER $PY3VER; do
  if [[ "${INSTALLED[(i)${VER}]}" -gt ${#INSTALLED} ]]; then
    echo "========================"
    echo "Installing Python ${VER}"
    echo "========================"
    py3_build_env ${VER}
    if [[ ! -z "${BUILD_ENV}" ]]; then
      echo "BUILD ENV: ${BUILD_ENV}"
    fi
    env ${BUILD_ENV} pyenv install ${VER}
  fi

  if [[ "${VER}" == "${PY3VER[1]}" ]]; then
    print "\n===== Installing Global Packages for ${VER}.\n\n"
    pyenv shell "${VER}"
    pip install ${GLOBAL_PACKAGES}
    pyenv shell --unset
  fi
done

# set up Jupiter3 environment
if [[ "${INSTALLED[(i)${JUPYTER_ENV}]}" -gt ${#INSTALLED} ]]; then
  pyenv virtualenv "${PY3_TOOLS}" "${JUPYTER_ENV}"
fi

print "\n===== Updating ${JUPYTER_ENV} setup.\n\n"
pyenv shell "${JUPYTER_ENV}" || exit "Failed to open jupyter shell"
pip install ${JUPYTER_PACKAGES}
python -m ipykernel install --user \
  --name "${JUPYTER_ENV}" --display-name "Python ${PY3_TOOLS}"
pyenv shell --unset

# set up tools3 environment
if [[ "${INSTALLED[(i)${TOOLS_ENV}]}" -gt ${#INSTALLED} ]]; then
  pyenv virtualenv "${PY3_TOOLS}" "${TOOLS_ENV}"
fi

print "\n===== Updating ${TOOLS_ENV} setup.\n\n"
pyenv shell "${TOOLS_ENV}" || exit "Failed to open tools shell"
pip install ${TOOLS_PACKAGES}
pyenv shell --unset

# set the global pyenv shim path
print "\n===== Setting global Python version list.\n\n"
pyenv global ${PY3VER} ${PY2VER} "${JUPYTER_ENV}" "${TOOLS_ENV}" system

echo "\n===== Updating virtualenvwrapper.\n\n"
pip install --upgrade virtualenvwrapper
