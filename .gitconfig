[user]
	name = Matthew Pounsett
	email = matt@conundrum.com
	signingkey = 07CFBD89017A24193AF427937E719F1B79088852

[init]
	defaultBranch = main

[commit]
	gpgsign = true

[tag]
	forceSignAnnotated = true

[push]
	default = simple

[core]
	excludesfile = ~/.gitignore_global

[alias]
lg1 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)' --all
lg2 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(auto)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)'
lg = lg1


# This whole IncludeIf thing doesn't work on most Linuxes because git is too
# far out of date.  This can be fixed on Debian and its derivatives by
# installing git 2.1 or later from backports.
[includeIf "gitdir/i:~/devel/nimbus/"]
	path = ~/.gitconfig-nimbus

[includeIf "gitdir/i:~/devel/oarc/"]
	path = ~/.gitconfig-oarc

[include]
	path = ~/.config/git/coderabbit
